  {
    "type": "function",
    "function": {
      "name": "template_compose",
      "description": "Save a reusable compound template assembled from saved templates. All anchors are LOCAL TOP-LEFT after rotation/mirror. Optional repeated columns/rows (default 1) with dx/dy pitch. Parts combine live cells by union (no erasure); up to 1024 instances and 4194304 input cells. Width/height must contain every transformed part. Does not touch canvas.",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,64}$"
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16384
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,64}$"
                },
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16383
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16383
                },
                "rotation": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 3,
                  "description": "Clockwise quarter turns before anchoring"
                },
                "mirror": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Horizontal flip before rotation"
                },
                "columns": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1024
                },
                "rows": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1024
                },
                "dx": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16384
                },
                "dy": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16384
                }
              },
              "required": [
                "name",
                "x",
                "y"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "width",
          "height",
          "parts"
        ],
        "additionalProperties": false
      }
    }
